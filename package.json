{
  "name": "snipcode",
  "version": "0.2.0",
  "description": "Your agent just got scissors. Cut any element from a live web page into clean code, or take the whole page's design. No LLM calls, no API keys.",
  "license": "MIT",
  "author": {
    "name": "micahtid",
    "url": "https://github.com/micahtid"
  },
  "homepage": "https://snipcode.micahtid.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micahtid/snipcode-plugin.git"
  },
  "bugs": "https://github.com/micahtid/snipcode-plugin/issues",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "ai-agent",
    "agent-tools",
    "component-extraction",
    "css-extraction",
    "design-tokens",
    "design-system",
    "html-to-react",
    "html-to-tailwind",
    "html-to-vue",
    "web-to-code",
    "code-generation",
    "browser-automation",
    "playwright",
    "cli"
  ],
  "type": "module",
  "bin": {
    "snipcode": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:core": "vite build --config core/vite.config.ts",
    "build:node": "vite build --config vite.node.config.ts",
    "build": "npm run build:core && npm run build:node",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc -p core/tsconfig.json && tsc -p tsconfig.node.json",
    "gen:skill": "tsx cli/src/gen-skill.ts",
    "verify:comments": "npm run build && tsx test/verify-comments.ts",
    "test": "npm run build && tsx test/unit.ts && tsx test/run.ts && tsx test/golden.ts && tsx test/fidelity.ts",
    "test:unit": "tsx test/unit.ts",
    "test:golden": "npm run build && tsx test/golden.ts",
    "test:fidelity": "npm run build && tsx test/fidelity.ts",
    "test:parity": "npm run build && tsx test/parity.ts",
    "verify": "npm run typecheck && npm run build && tsx test/unit.ts && tsx test/run.ts && tsx test/golden.ts && tsx test/fidelity.ts"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^7.0.0"
  }
}
