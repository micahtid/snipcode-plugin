{
  "name": "snipcode",
  "version": "0.1.0",
  "description": "Deterministic eyes and hands for AI agents: load a page, harvest its elements, extract any one into clean self-contained code, or read a whole-page design schema. Zero LLM calls, zero API keys.",
  "license": "MIT",
  "author": {
    "name": "micahtid",
    "url": "https://github.com/micahtid"
  },
  "homepage": "https://snipcode.micahtid.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micahtid/snip-code-cli.git"
  },
  "bugs": "https://github.com/micahtid/snip-code-cli/issues",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "ai-agent",
    "agent-tools",
    "component-extraction",
    "css-extraction",
    "design-tokens",
    "design-system",
    "html-to-react",
    "html-to-tailwind",
    "html-to-vue",
    "web-to-code",
    "code-generation",
    "browser-automation",
    "playwright",
    "cli"
  ],
  "type": "module",
  "bin": {
    "snipcode": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:core": "vite build --config core/vite.config.ts",
    "build:node": "vite build --config vite.node.config.ts",
    "build": "npm run build:core && npm run build:node",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc -p core/tsconfig.json && tsc -p tsconfig.node.json",
    "gen:skill": "tsx cli/src/gen-skill.ts",
    "test": "npm run build && tsx test/unit.ts && tsx test/run.ts && tsx test/golden.ts && tsx test/fidelity.ts",
    "test:unit": "tsx test/unit.ts",
    "test:golden": "npm run build && tsx test/golden.ts",
    "test:fidelity": "npm run build && tsx test/fidelity.ts",
    "test:parity": "npm run build && tsx test/parity.ts"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^7.0.0"
  }
}
